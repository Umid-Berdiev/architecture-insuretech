<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device"><diagram id="to-be" name="InsureTech to-be"><mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2339" pageHeight="1654" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b style='font-size:20px'&gt;InsureTech — технологическая архитектура (to-be)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Целевые показатели: доступность 99,9 %, RTO 45 мин, RPO 15 мин, 24/7, одинаковое время загрузки страниц из всех регионов РФ&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="60" as="geometry" /></mxCell><mxCell id="browser" value="&lt;b&gt;Браузер пользователя&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;регионы РФ, все часовые пояса&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff5958;verticalAlign=bottom;spacingBottom=6;spacingLeft=6;spacingRight=6;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="640" y="90" width="200" height="100" as="geometry" /></mxCell><mxCell id="browser_i" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="browser"><mxGeometry x="84.0" y="8" width="32" height="32" as="geometry" /></mxCell><mxCell id="partner" value="&lt;b&gt;Системы партнёров&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;B2B API, квота 20 RPS на партнёра&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff5958;verticalAlign=bottom;spacingBottom=6;spacingLeft=6;spacingRight=6;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="900" y="90" width="200" height="100" as="geometry" /></mxCell><mxCell id="partner_i" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="partner"><mxGeometry x="84.0" y="8" width="32" height="32" as="geometry" /></mxCell><mxCell id="dns" value="&lt;b&gt;Cloud DNS&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;insuretech.ru → anycast-IP ALB&lt;br&gt;TTL 60 с (быстрое переключение)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff5958;verticalAlign=bottom;spacingBottom=6;spacingLeft=6;spacingRight=6;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="300" y="230" width="240" height="100" as="geometry" /></mxCell><mxCell id="dns_i" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="dns"><mxGeometry x="104.0" y="8" width="32" height="32" as="geometry" /></mxCell><mxCell id="cdn" value="&lt;b&gt;Yandex Cloud CDN&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;edge-узлы в регионах РФ: статика SPA (JS/CSS/img),&lt;br&gt;HTTP/2, gzip/brotli, TLS termination на edge&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff5958;verticalAlign=bottom;spacingBottom=6;spacingLeft=6;spacingRight=6;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1180" y="230" width="300" height="100" as="geometry" /></mxCell><mxCell id="cdn_i" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="cdn"><mxGeometry x="134.0" y="8" width="32" height="32" as="geometry" /></mxCell><mxCell id="region" value="&lt;b&gt;Yandex Cloud — регион ru-central1&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font style='font-size:12px'&gt;(один регион РФ; все сервисы ниже — региональные, разнесены по трём зонам доступности)&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f3f6fd;strokeColor=#5282ff;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=16;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="1740" height="1200" as="geometry" /></mxCell><mxCell id="alb" value="&lt;b&gt;Application Load Balancer (L7)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;региональный, anycast-IP, HTTPS-listener :443, active-active на 3 зоны; backend group = ingress-узлы всех зон, веса 1:1:1; rate-limit per partner (20 RPS)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff5958;verticalAlign=bottom;spacingBottom=6;spacingLeft=6;spacingRight=6;fontSize=12;fontFamily=Arial;" vertex="1" parent="region"><mxGeometry x="520" y="30" width="520" height="100" as="geometry" /></mxCell><mxCell id="alb_i" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="alb"><mxGeometry x="244.0" y="8" width="32" height="32" as="geometry" /></mxCell><mxCell id="az_a" value="&lt;b&gt;Зона доступности ru-central1-a&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dbe5fb;strokeColor=none;verticalAlign=bottom;align=center;spacingBottom=6;fontSize=16;fontFamily=Arial;" vertex="1" parent="region"><mxGeometry x="30" y="190" width="530" height="970" as="geometry" /></mxCell><mxCell id="az_b" value="&lt;b&gt;Зона доступности ru-central1-b&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dbe5fb;strokeColor=none;verticalAlign=bottom;align=center;spacingBottom=6;fontSize=16;fontFamily=Arial;" vertex="1" parent="region"><mxGeometry x="610" y="190" width="530" height="970" as="geometry" /></mxCell><mxCell id="az_d" value="&lt;b&gt;Зона доступности ru-central1-d&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dbe5fb;strokeColor=none;verticalAlign=bottom;align=center;spacingBottom=6;fontSize=16;fontFamily=Arial;" vertex="1" parent="region"><mxGeometry x="1190" y="190" width="530" height="970" as="geometry" /></mxCell><mxCell id="k8s" value="&lt;b&gt;Managed Service for Kubernetes — кластер 1 (региональный)&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font style='font-size:11px'&gt;мастер ×3 (по одному в каждой зоне), node group в каждой зоне, Cluster Autoscaler; один кластер вместо трёх независимых — см. комментарий ②&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5282ff;verticalAlign=top;align=left;spacingLeft=48;spacingTop=4;fontSize=13;fontFamily=Arial;" vertex="1" parent="region"><mxGeometry x="50" y="230" width="1650" height="360" as="geometry" /></mxCell><mxCell id="k8s_i" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="k8s"><mxGeometry x="8" y="6" width="32" height="32" as="geometry" /></mxCell><mxCell id="ng_a" value="&lt;b&gt;Node group ru-central1-a&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;2–6 узлов, autoscaling&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5282ff;verticalAlign=top;align=left;spacingLeft=48;spacingTop=4;fontSize=13;fontFamily=Arial;" vertex="1" parent="k8s"><mxGeometry x="10" y="50" width="470" height="300" as="geometry" /></mxCell><mxCell id="ng_a_i" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="ng_a"><mxGeometry x="8" y="6" width="32" height="32" as="geometry" /></mxCell><mxCell id="ns_a" value="&lt;b&gt;InsureTech namespace&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;ingress-nginx ×1 (NodePort) · core-app ×2 · client-info ×2&lt;br&gt;ins-product-aggregator ×2 · ins-comp-settlement ×1&lt;br&gt;HPA (CPU / RPS), podAntiAffinity по зонам, PDB,&lt;br&gt;&lt;font color='#ff5958'&gt;readiness / liveness probes: GET /actuator/health, 10 с&lt;/font&gt;&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff5958;verticalAlign=bottom;spacingBottom=6;spacingLeft=6;spacingRight=6;fontSize=12;fontFamily=Arial;" vertex="1" parent="ng_a"><mxGeometry x="30" y="50" width="410" height="210" as="geometry" /></mxCell><mxCell id="ns_a_i" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="ns_a"><mxGeometry x="189.0" y="8" width="32" height="32" as="geometry" /></mxCell><mxCell id="ng_b" value="&lt;b&gt;Node group ru-central1-b&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;2–6 узлов, autoscaling&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5282ff;verticalAlign=top;align=left;spacingLeft=48;spacingTop=4;fontSize=13;fontFamily=Arial;" vertex="1" parent="k8s"><mxGeometry x="590" y="50" width="470" height="300" as="geometry" /></mxCell><mxCell id="ng_b_i" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="ng_b"><mxGeometry x="8" y="6" width="32" height="32" as="geometry" /></mxCell><mxCell id="ns_b" value="&lt;b&gt;InsureTech namespace&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;ingress-nginx ×1 (NodePort) · core-app ×2 · client-info ×2&lt;br&gt;ins-product-aggregator ×2 · ins-comp-settlement ×1&lt;br&gt;HPA (CPU / RPS), podAntiAffinity по зонам, PDB,&lt;br&gt;&lt;font color='#ff5958'&gt;readiness / liveness probes: GET /actuator/health, 10 с&lt;/font&gt;&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff5958;verticalAlign=bottom;spacingBottom=6;spacingLeft=6;spacingRight=6;fontSize=12;fontFamily=Arial;" vertex="1" parent="ng_b"><mxGeometry x="30" y="50" width="410" height="210" as="geometry" /></mxCell><mxCell id="ns_b_i" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="ns_b"><mxGeometry x="189.0" y="8" width="32" height="32" as="geometry" /></mxCell><mxCell id="ng_d" value="&lt;b&gt;Node group ru-central1-d&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;2–6 узлов, autoscaling&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5282ff;verticalAlign=top;align=left;spacingLeft=48;spacingTop=4;fontSize=13;fontFamily=Arial;" vertex="1" parent="k8s"><mxGeometry x="1170" y="50" width="470" height="300" as="geometry" /></mxCell><mxCell id="ng_d_i" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="ng_d"><mxGeometry x="8" y="6" width="32" height="32" as="geometry" /></mxCell><mxCell id="ns_d" value="&lt;b&gt;InsureTech namespace&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;ingress-nginx ×1 (NodePort) · core-app ×2 · client-info ×2&lt;br&gt;ins-product-aggregator ×2 · ins-comp-settlement ×1&lt;br&gt;HPA (CPU / RPS), podAntiAffinity по зонам, PDB,&lt;br&gt;&lt;font color='#ff5958'&gt;readiness / liveness probes: GET /actuator/health, 10 с&lt;/font&gt;&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff5958;verticalAlign=bottom;spacingBottom=6;spacingLeft=6;spacingRight=6;fontSize=12;fontFamily=Arial;" vertex="1" parent="ng_d"><mxGeometry x="30" y="50" width="410" height="210" as="geometry" /></mxCell><mxCell id="ns_d_i" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="ns_d"><mxGeometry x="189.0" y="8" width="32" height="32" as="geometry" /></mxCell><mxCell id="pgc" value="&lt;b&gt;Managed Service for PostgreSQL — кластер из 3 хостов&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font style='font-size:11px'&gt;HA на базе Patroni + DCS: автоматический failover ≈ 30 с; rw-FQDN / ro-FQDN для приложений; connection pooler (Odyssey) на каждом хосте; без шардирования — см. комментарий ⑥&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5282ff;verticalAlign=top;align=left;spacingLeft=48;spacingTop=4;fontSize=13;fontFamily=Arial;" vertex="1" parent="region"><mxGeometry x="50" y="630" width="1650" height="300" as="geometry" /></mxCell><mxCell id="pgc_i" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="pgc"><mxGeometry x="8" y="6" width="32" height="32" as="geometry" /></mxCell><mxCell id="pg_a" value="&lt;b&gt;PostgreSQL — master (RW)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;ru-central1-a · запись и чтение&lt;br&gt;архивация WAL непрерывно (archive_timeout 5 мин)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff5958;verticalAlign=bottom;spacingBottom=6;spacingLeft=6;spacingRight=6;fontSize=12;fontFamily=Arial;" vertex="1" parent="pgc"><mxGeometry x="30" y="50" width="420" height="130" as="geometry" /></mxCell><mxCell id="pg_a_i" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="pg_a"><mxGeometry x="194.0" y="8" width="32" height="32" as="geometry" /></mxCell><mxCell id="pg_b" value="&lt;b&gt;PostgreSQL — синхронная реплика&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;ru-central1-b · кандидат на failover&lt;br&gt;RPO ≈ 0 (synchronous_commit = on)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff5958;verticalAlign=bottom;spacingBottom=6;spacingLeft=6;spacingRight=6;fontSize=12;fontFamily=Arial;" vertex="1" parent="pgc"><mxGeometry x="610" y="50" width="420" height="130" as="geometry" /></mxCell><mxCell id="pg_b_i" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="pg_b"><mxGeometry x="194.0" y="8" width="32" height="32" as="geometry" /></mxCell><mxCell id="pg_d" value="&lt;b&gt;PostgreSQL — асинхронная реплика&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;ru-central1-d · чтение (ro-FQDN): каталог продуктов, тарифы, отчёты&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff5958;verticalAlign=bottom;spacingBottom=6;spacingLeft=6;spacingRight=6;fontSize=12;fontFamily=Arial;" vertex="1" parent="pgc"><mxGeometry x="1190" y="50" width="420" height="130" as="geometry" /></mxCell><mxCell id="pg_d_i" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="pg_d"><mxGeometry x="194.0" y="8" width="32" height="32" as="geometry" /></mxCell><mxCell id="pg_note" value="&lt;font style='font-size:11px'&gt;Вертикальное масштабирование хоста БД (vCPU/RAM/SSD) — достаточно для 50 GB; горизонтально — только чтение через реплики&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontFamily=Arial;" vertex="1" parent="pgc"><mxGeometry x="30" y="210" width="1600" height="30" as="geometry" /></mxCell><mxCell id="s3_backup" value="&lt;b&gt;Object Storage — бэкапы БД&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;ежедневный полный бэкап + непрерывный WAL-архив → PITR на любую точку;&lt;br&gt;хранение 7 дней; бакет реплицируется по 3 зонам региона&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff5958;verticalAlign=bottom;spacingBottom=6;spacingLeft=6;spacingRight=6;fontSize=12;fontFamily=Arial;" vertex="1" parent="region"><mxGeometry x="80" y="970" width="520" height="110" as="geometry" /></mxCell><mxCell id="s3_backup_i" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="s3_backup"><mxGeometry x="244.0" y="8" width="32" height="32" as="geometry" /></mxCell><mxCell id="s3_static" value="&lt;b&gt;Object Storage — статика InsureTech Web&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;origin для CDN: React SPA (index.html, JS, CSS, img);&lt;br&gt;деплой через CI/CD, версии по hash&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff5958;verticalAlign=bottom;spacingBottom=6;spacingLeft=6;spacingRight=6;fontSize=12;fontFamily=Arial;" vertex="1" parent="region"><mxGeometry x="1140" y="970" width="480" height="110" as="geometry" /></mxCell><mxCell id="s3_static_i" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="s3_static"><mxGeometry x="224.0" y="8" width="32" height="32" as="geometry" /></mxCell><mxCell id="mon" value="&lt;b&gt;Yandex Monitoring + Alerting&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;метрики ALB / k8s / PostgreSQL, SLO 99,9 %, алерты on-call (Telegram / телефон) при ошибках HC&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ff5958;verticalAlign=bottom;spacingBottom=6;spacingLeft=6;spacingRight=6;fontSize=12;fontFamily=Arial;" vertex="1" parent="region"><mxGeometry x="1140" y="30" width="400" height="100" as="geometry" /></mxCell><mxCell id="mon_i" value="" style="shape=image;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="mon"><mxGeometry x="184.0" y="8" width="32" height="32" as="geometry" /></mxCell><mxCell id="e1" value="1. DNS-запрос: insuretech.ru" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;fontFamily=Arial;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="browser" target="dns"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="2. Статика SPA (HTTPS)&lt;br&gt;ближайший edge-узел" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;fontFamily=Arial;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="browser" target="cdn"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="3. REST API / HTML (HTTPS, HTTP/2)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;fontFamily=Arial;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="browser" target="alb"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="REST API (HTTPS) · API-ключ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;fontFamily=Arial;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="partner" target="alb"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="origin при cache-miss (HTTPS)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;fontFamily=Arial;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cdn" target="s3_static"><mxGeometry relative="1" x="-0.9" as="geometry"><Array as="points"><mxPoint x="1768" y="280" /><mxPoint x="1768" y="1395" /></Array></mxGeometry></mxCell><mxCell id="e6" value="HTTPS → ingress (NodePort)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;fontFamily=Arial;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="alb" target="ns_a"><mxGeometry relative="1" x="-1" as="geometry"><mxPoint x="0" y="22" as="offset" /><Array as="points"><mxPoint x="638.0" y="540" /><mxPoint x="376.0" y="540" /></Array></mxGeometry></mxCell><mxCell id="e7" value="health check: GET /healthz&lt;br&gt;каждые 2 с, таймаут 1 с,&lt;br&gt;3 неудачи → зона исключается" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;fontFamily=Arial;dashed=1;strokeColor=#ff5958;fontColor=#ff5958;exitX=0.05;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="alb" target="ns_a"><mxGeometry relative="1" x="-1" as="geometry"><mxPoint x="0" y="60" as="offset" /><Array as="points"><mxPoint x="586.0" y="585" /><mxPoint x="478.5" y="585" /></Array></mxGeometry></mxCell><mxCell id="e8" value="HTTPS → ingress (NodePort)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;fontFamily=Arial;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="alb" target="ns_b"><mxGeometry relative="1" x="-1" as="geometry"><mxPoint x="0" y="22" as="offset" /><Array as="points"><mxPoint x="820.0" y="540" /><mxPoint x="956.0" y="540" /></Array></mxGeometry></mxCell><mxCell id="e9" value="health check: GET /healthz&lt;br&gt;каждые 2 с, таймаут 1 с,&lt;br&gt;3 неудачи → зона исключается" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;fontFamily=Arial;dashed=1;strokeColor=#ff5958;fontColor=#ff5958;exitX=0.6;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="alb" target="ns_b"><mxGeometry relative="1" x="-1" as="geometry"><mxPoint x="0" y="60" as="offset" /><Array as="points"><mxPoint x="872.0" y="585" /><mxPoint x="1058.5" y="585" /></Array></mxGeometry></mxCell><mxCell id="e10" value="HTTPS → ingress (NodePort)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;fontFamily=Arial;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="alb" target="ns_d"><mxGeometry relative="1" x="-1" as="geometry"><mxPoint x="0" y="22" as="offset" /><Array as="points"><mxPoint x="1002.0" y="540" /><mxPoint x="1536.0" y="540" /></Array></mxGeometry></mxCell><mxCell id="e11" value="health check: GET /healthz&lt;br&gt;каждые 2 с, таймаут 1 с,&lt;br&gt;3 неудачи → зона исключается" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;fontFamily=Arial;dashed=1;strokeColor=#ff5958;fontColor=#ff5958;exitX=0.95;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="alb" target="ns_d"><mxGeometry relative="1" x="-1" as="geometry"><mxPoint x="0" y="60" as="offset" /><Array as="points"><mxPoint x="1054.0" y="585" /><mxPoint x="1638.5" y="585" /></Array></mxGeometry></mxCell><mxCell id="e12" value="RW: rw-FQDN кластера&lt;br&gt;TCP 6432 (Odyssey)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;fontFamily=Arial;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ns_a" target="pg_a"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e13" value="RW: rw-FQDN" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;fontFamily=Arial;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ns_b" target="pg_a"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="805" y="980" /><mxPoint x="456" y="980" /></Array></mxGeometry></mxCell><mxCell id="e14" value="RW: rw-FQDN" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;fontFamily=Arial;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ns_d" target="pg_a"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1385" y="985" /><mxPoint x="498" y="985" /></Array></mxGeometry></mxCell><mxCell id="e15" value="RO: ro-FQDN (тарифы, продукты)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;fontFamily=Arial;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ns_d" target="pg_d"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e16" value="синхронная репликация (streaming)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;fontFamily=Arial;strokeColor=#5282ff;fontColor=#1f3f99;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="pg_a" target="pg_b"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e17" value="асинхронная репликация" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;fontFamily=Arial;strokeColor=#5282ff;fontColor=#1f3f99;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="pg_b" target="pg_d"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e18" value="Patroni: проверка лидера через DCS каждые 10 с;&lt;br&gt;нет ответа 30 с → promote синхронной реплики" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;fontFamily=Arial;dashed=1;strokeColor=#ff5958;fontColor=#ff5958;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="pg_b" target="pg_a"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e19" value="WAL-архив + ежедневный full backup" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;fontFamily=Arial;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pg_a" target="s3_backup"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e20" value="метрики, статус HC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;fontFamily=Arial;dashed=1;dashPattern=1 3;strokeColor=#999999;fontColor=#777777;endArrow=open;endFill=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="alb" target="mon"><mxGeometry relative="1" x="-0.2" as="geometry" /></mxCell><mxCell id="e21" value="метрики подов и узлов, probes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;fontFamily=Arial;dashed=1;dashPattern=1 3;strokeColor=#999999;fontColor=#777777;endArrow=open;endFill=0;exitX=0.9;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="k8s" target="mon"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1575" y="585" /><mxPoint x="1380" y="585" /></Array></mxGeometry></mxCell><mxCell id="e22" value="метрики БД, состояние Patroni" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;fontFamily=Arial;dashed=1;dashPattern=1 3;strokeColor=#999999;fontColor=#777777;endArrow=open;endFill=0;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="pgc" target="mon"><mxGeometry relative="1" x="0.3" as="geometry"><Array as="points"><mxPoint x="1752" y="1090" /><mxPoint x="1752" y="560" /><mxPoint x="1460" y="560" /></Array></mxGeometry></mxCell><mxCell id="note0" value="&lt;b&gt;① Стратегия масштабирования и отказоустойчивости&lt;/b&gt;&lt;br&gt;Горизонтальное масштабирование: сервисы stateless, реплики подов (HPA по CPU и RPS) и узлы (Cluster Autoscaler) добавляются под нагрузку рекламной кампании; пиковые 50 RPS поиска / 10 RPS оформления / 250 RPS партнёров закрываются 2–3 репликами на зону. Вертикальное — только для хоста PostgreSQL (vCPU/RAM/SSD): объём 50 GB не требует распределённой БД.&lt;br&gt;Три зоны доступности обязательны: один зал/ВМ даёт SPOF, а 99,9 % (≤ 8,8 ч простоя в год) при RTO 45 мин недостижимы при отказе зоны. Все сервисы — региональные, деплой в ru-central1-a/b/d." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1810" y="370" width="470" height="190" as="geometry" /></mxCell><mxCell id="note1" value="&lt;b&gt;② Конфигурация Kubernetes: один региональный кластер&lt;/b&gt;&lt;br&gt;Выбран один растянутый (региональный) кластер Managed Kubernetes с мастерами в трёх зонах и node group в каждой зоне, а не три независимых. Причины: один набор манифестов и один pipeline деплоя; один Service/Ingress — ALB видит все зоны как один backend group; podAntiAffinity + topologySpreadConstraints гарантируют реплики в каждой зоне; отказ зоны обрабатывает сам планировщик (пересоздание подов в живых зонах) без внешней оркестрации. Задержка между зонами одного региона &lt; 2 мс, поэтому stretched-кластер не вносит накладных расходов. Независимые кластеры оправданы только при геораспределении между регионами — для РФ в Yandex Cloud доступен один регион." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1810" y="570" width="470" height="215" as="geometry" /></mxCell><mxCell id="note2" value="&lt;b&gt;③ Балансировка нагрузки и health checks&lt;/b&gt;&lt;br&gt;Клиент → Cloud DNS (TTL 60 с) → anycast-IP ALB. ALB (L7) терминирует TLS, маршрутизирует по хостам/путям (/api/partner/* — отдельный backend с rate-limit 20 RPS на API-ключ) и распределяет запросы между ingress-узлами трёх зон (round robin, веса 1:1:1, locality-aware). Статика SPA — через CDN с edge-узлами в регионах РФ, поэтому время загрузки страницы не зависит от географии пользователя; API-запросы идут в один регион с одинаковой задержкой для всех.&lt;br&gt;Health checks (красный пунктир): ALB → ingress GET /healthz каждые 2 с, таймаут 1 с, 3 неудачи = unhealthy, 2 успеха = healthy; kubelet → поды: readiness/liveness GET /actuator/health 10 с; Patroni → лидер PostgreSQL через DCS 10 с; CDN → origin (Object Storage) при cache-miss. Результаты HC — в Monitoring." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1810" y="795" width="470" height="215" as="geometry" /></mxCell><mxCell id="note3" value="&lt;b&gt;④ Failover-стратегия: active-active по трём зонам&lt;/b&gt;&lt;br&gt;Все три зоны обслуживают трафик одновременно; «тёплого резерва» нет — это проще и дешевле, а переключение не требует ручных действий. Отказ зоны: ALB исключает её ingress через ≈ 6 с (3 × 2 с); клиент видит только ретрай запроса (SPA повторяет идемпотентные GET; POST оформления — через idempotency-key). Отказ ALB-узла — anycast-IP, прозрачно. Отказ мастера БД — Patroni за ≈ 30 с переводит синхронную реплику в master, rw-FQDN переключается автоматически, пулы соединений переподключаются. Итог: фактический RTO &lt; 5 мин (требование 45 мин), RPO ≈ 0 для отказа зоны (требование 15 мин). CDN продолжает отдавать оболочку сайта даже во время failover бэкенда." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1810" y="1020" width="470" height="215" as="geometry" /></mxCell><mxCell id="note4" value="&lt;b&gt;⑤ Конфигурация базы данных (RTO/RPO)&lt;/b&gt;&lt;br&gt;Managed Service for PostgreSQL, 3 хоста по одному в зоне: master (a), синхронная реплика (b), асинхронная реплика для чтения (d). Кластер управляется Patroni (DCS — etcd/ZooKeeper управляемого сервиса): автоматический выбор лидера, fencing старого мастера, переключение FQDN. Синхронная репликация даёт RPO ≈ 0 при потере зоны; асинхронная реплика разгружает чтение тарифов и отчёты.&lt;br&gt;Резервное копирование: ежедневный полный бэкап + непрерывная архивация WAL (archive_timeout 5 мин) в Object Storage (реплицируется по трём зонам) → PITR на любую точку, RPO ≤ 5 мин даже при логической порче данных; восстановление 50 GB из бэкапа ≈ 15–20 мин, что укладывается в RTO 45 мин. Хранение бэкапов — 7 дней, еженедельная проверка восстановления." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1810" y="1245" width="470" height="215" as="geometry" /></mxCell><mxCell id="note5" value="&lt;b&gt;⑥ Шардирование БД: не применяется&lt;/b&gt;&lt;br&gt;Объём данных 50 GB и умеренная нагрузка (десятки RPS на запись) помещаются на один хост PostgreSQL с запасом на порядок; вертикальное масштабирование хоста и read-реплики закрывают рост на ближайшие годы. Шардирование добавило бы сложность (роутер, кросс-шардовые транзакции для «заявка + клиент», отсутствие внешних ключей, усложнение бэкапов) без выигрыша. Пересмотреть при &gt; 1 TB или &gt; 5 000 RPS на запись; естественный ключ шардирования на будущее — client_id (данные клиента и его заявки на одном шарде). Схемы сервисов уже разделены — при необходимости их можно вынести в отдельные кластеры по сервисам." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1810" y="1470" width="470" height="190" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;Обозначения&lt;/b&gt;&lt;br&gt;&lt;font color='#ff5958'&gt;▬ ▬&lt;/font&gt; health check &amp;nbsp;&amp;nbsp; &lt;font color='#5282ff'&gt;▬▬&lt;/font&gt; репликация БД &amp;nbsp;&amp;nbsp; &lt;font color='#999999'&gt;· · ·&lt;/font&gt; метрики/алерты &amp;nbsp;&amp;nbsp; ▬▬ пользовательский трафик&lt;br&gt;Нотация: библиотеки Yandex Cloud (services / containers, окт. 2023)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="40" y="1580" width="900" height="50" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>