="1" parent="1"><mxGeometry x="1135" y="692" width="24" height="23" as="geometry" /></mxCell><mxCell id="task4-16" value="TimeOut&lt;br&gt;5 с / 3 с" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;fontSize=9;fontColor=#333333;points=[[0.005,0.63,0],[0.1,0.2,0],[0.9,0.2,0],[0.5,0,0],[0.995,0.63,0],[0.72,0.99,0],[0.5,1,0],[0.28,0.99,0]];shape=mxgraph.kubernetes.icon2;prIcon=quota;" vertex="1" parent="1"><mxGeometry x="1795" y="312" width="24" height="23" as="geometry" /></mxCell><mxCell id="task4-17" value="Retry&lt;br&gt;3× backoff" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;fontSize=9;fontColor=#333333;points=[[0.005,0.63,0],[0.1,0.2,0],[0.9,0.2,0],[0.5,0,0],[0.995,0.63,0],[0.72,0.99,0],[0.5,1,0],[0.28,0.99,0]];shape=mxgraph.kubernetes.icon2;prIcon=deploy;" vertex="1" parent="1"><mxGeometry x="1795" y="364" width="24" height="23" as="geometry" /></mxCell><mxCell id="task4-18" value="Circuit&lt;br&gt;Breaker" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;fontSize=9;fontColor=#333333;points=[[0.005,0.63,0],[0.1,0.2,0],[0.9,0.2,0],[0.5,0,0],[0.995,0.63,0],[0.72,0.99,0],[0.5,1,0],[0.28,0.99,0]];shape=mxgraph.kubernetes.icon2;prIcon=c_role;" vertex="1" parent="1"><mxGeometry x="1795" y="416" width="24" height="23" as="geometry" /></mxCell><mxCell id="task4-19" value="Rate Limiter&lt;br&gt;по договору" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;fontSize=9;fontColor=#333333;points=[[0.005,0.63,0],[0.1,0.2,0],[0.9,0.2,0],[0.5,0,0],[0.995,0.63,0],[0.72,0.99,0],[0.5,1,0],[0.28,0.99,0]];shape=mxgraph.kubernetes.icon2;prIcon=job;" vertex="1" parent="1"><mxGeometry x="1795" y="468" width="24" height="23" as="geometry" /></mxCell><mxCell id="task4-20" value="TimeOut" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;fontSize=9;fontColor=#333333;points=[[0.005,0.63,0],[0.1,0.2,0],[0.9,0.2,0],[0.5,0,0],[0.995,0.63,0],[0.72,0.99,0],[0.5,1,0],[0.28,0.99,0]];shape=mxgraph.kubernetes.icon2;prIcon=quota;" vertex="1" parent="1"><mxGeometry x="55" y="785" width="26" height="25" as="geometry" /></mxCell><mxCell id="task4-21" value="Retry" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;fontSize=9;fontColor=#333333;points=[[0.005,0.63,0],[0.1,0.2,0],[0.9,0.2,0],[0.5,0,0],[0.995,0.63,0],[0.72,0.99,0],[0.5,1,0],[0.28,0.99,0]];shape=mxgraph.kubernetes.icon2;prIcon=deploy;" vertex="1" parent="1"><mxGeometry x="125" y="785" width="26" height="25" as="geometry" /></mxCell><mxCell id="task4-22" value="Rate Limiter" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;fontSize=9;fontColor=#333333;points=[[0.005,0.63,0],[0.1,0.2,0],[0.9,0.2,0],[0.5,0,0],[0.995,0.63,0],[0.72,0.99,0],[0.5,1,0],[0.28,0.99,0]];shape=mxgraph.kubernetes.icon2;prIcon=job;" vertex="1" parent="1"><mxGeometry x="195" y="785" width="26" height="25" as="geometry" /></mxCell><mxCell id="task4-23" value="Circuit Breaker" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;fontSize=9;fontColor=#333333;points=[[0.005,0.63,0],[0.1,0.2,0],[0.9,0.2,0],[0.5,0,0],[0.995,0.63,0],[0.72,0.99,0],[0.5,1,0],[0.28,0.99,0]];shape=mxgraph.kubernetes.icon2;prIcon=c_role;" vertex="1" parent="1"><mxGeometry x="265" y="785" width="26" height="25" as="geometry" /></mxCell><mxCell id="task4-24" value="&lt;b&gt;Решения (задание 4, ОСАГО)&lt;/b&gt;&lt;br&gt;1. osago-aggregator — отдельный сервис с собственной БД: заявка, id в каждой СК, дедлайн 60 с, lease опроса и предложения должны переживать рестарт и быть видны всем экземплярам.&lt;br&gt;2. API для core-app — события Kafka: команда osago.request (через outbox core-app) и события osago.offers (одно на каждый ответ, отказ или таймаут СК); ключ — id заявки, порядок внутри заявки сохраняется партиционированием.&lt;br&gt;3. API для веб-приложения: REST POST создаёт заявку и возвращает id; WebSocket отдаёт предложения сразу по приходу; REST GET возвращает текущий список при переподключении.&lt;br&gt;4. Несколько экземпляров: предложение приходит в один экземпляр core-app, а WebSocket клиента открыт на другом — Redis Pub/Sub рассылает событие всем; лимит вызовов СК общий на все экземпляры osago-aggregator — token bucket в Redis; опрос одной заявки ведёт один экземпляр (lease в БД, перехват при падении).&lt;br&gt;5. Паттерны: Rate Limiter и TimeOut на входе в core-app; Retry (reconnect) и TimeOut 60 с на WebSocket; Retry + DLQ у продюсеров и консьюмеров Kafka; на адаптерах СК — TimeOut (5 с create, 3 с poll), Retry 3× с backoff только для идемпотентного create, Circuit Breaker на каждую СК (50 % ошибок из 20 вызовов → открыт 30 с), Rate Limiter по договору с СК." vertex="1" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#333333;"><mxGeometry x="40" y="1250" width="300" height="430" as="geometry" /></mxCell></root>
    </mxGraphModel>
  </diagram>
</mxfile>