c4Description%&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center&quot;&gt;[%c4Technology%]&lt;/div&gt;&lt;/div&gt;"><mxCell style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;elbow=vertical;metaEdit=1;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;edgeStyle=orthogonalEdgeStyle;dashed=1;dashPattern=6 4;strokeColor=#0E7DAD;fontColor=#0E7DAD;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="task3-2" target="task3-1"><mxGeometry width="160" relative="1" as="geometry" /></mxCell></object><object placeholders="1" id="task3-8" c4Type="Relationship" c4Technology="Debezium PostgreSQL connector" c4Description="Чтение outbox (CDC)" label="&lt;div style=&quot;text-align: left&quot;&gt;&lt;div style=&quot;text-align: center&quot;&gt;&lt;b&gt;%c4Description%&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center&quot;&gt;[%c4Technology%]&lt;/div&gt;&lt;/div&gt;"><mxCell style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;elbow=vertical;metaEdit=1;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;edgeStyle=orthogonalEdgeStyle;dashed=1;dashPattern=6 4;strokeColor=#0E7DAD;fontColor=#0E7DAD;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="uZ0quFO-MIEIE11IO5jD-2" target="task3-2"><mxGeometry width="160" relative="1" as="geometry"><Array as="points"><mxPoint x="670" y="770" /><mxPoint x="805" y="770" /></Array></mxGeometry></mxCell></object><object placeholders="1" id="task3-9" c4Type="Relationship" c4Technology="TCP" c4Description="Работа с данными" label="&lt;div style=&quot;text-align: left&quot;&gt;&lt;div style=&quot;text-align: center&quot;&gt;&lt;b&gt;%c4Description%&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center&quot;&gt;[%c4Technology%]&lt;/div&gt;&lt;/div&gt;"><mxCell style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;elbow=vertical;metaEdit=1;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="uZ0quFO-MIEIE11IO5jD-16" target="task3-3"><mxGeometry width="160" relative="1" as="geometry" /></mxCell></object><mxCell id="task3-10" value="&lt;b&gt;Обозначения&lt;/b&gt;&lt;br&gt;&lt;font color='#0E7DAD'&gt;- - -&amp;gt;&lt;/font&gt; асинхронное взаимодействие через Kafka (event streaming)&lt;br&gt;——&amp;gt; синхронный вызов (REST / WebSocket / TCP)&lt;br&gt;&lt;br&gt;&lt;b&gt;Паттерны отказоустойчивости&lt;/b&gt; (иконки у стрелок):" vertex="1" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#333333;"><mxGeometry x="40" y="690" width="300" height="200" as="geometry" /></mxCell><mxCell id="task3-11" value="&lt;b&gt;Решения (задание 3)&lt;/b&gt;&lt;br&gt;1. ins-product-aggregator больше не опрашивает 5–10 СК внутри синхронного запроса: опрос каждой СК идёт по расписанию, независимо, с таймаутом и circuit breaker; результат хранится в своей БД и публикуется в топик products.&lt;br&gt;2. core-app и ins-comp-settlement читают products из Kafka вместо REST-опроса раз в 15 мин / раз в сутки; compacted-топик даёт полный актуальный каталог новому потребителю.&lt;br&gt;3. Реестр оформленных страховок уходит в ins-comp-settlement событиями policy.issued, а не ночным REST-запросом.&lt;br&gt;4. Transactional Outbox применяется для policy.issued (страховка и событие пишутся в одной транзакции core-db, Debezium доставляет в Kafka). Для событий каталога outbox не нужен: это снимок, который переиздаётся при следующем опросе.&lt;br&gt;5. Синхронными остаются вызовы, где нужен ответ сразу: веб и партнёрский API → core-app, client-info, платежи, передача данных для взаиморасчётов в СК." vertex="1" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#333333;"><mxGeometry x="40" y="900" width="300" height="330" as="geometry" /></mxCell><object placeholders="1" id="task4-1" c4Name="osago-aggregator" c4Type="Container" label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" c4Technology="Kotlin, SpringBoot (N экземпляров)" c4Description="Принимает заявки на ОСАГО из Kafka, создаёт их во всех СК, опрашивает решения до 60 с и публикует каждое предложение сразу по получении. Один адаптер на СК; опрос заявки держит один экземпляр по lease в БД"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="1520" y="320" width="240" height="130" as="geometry" /></mxCell></object><object placeholders="1" id="task4-2" c4Type="osago-aggregator-db" c4Container="Container" label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Type%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Container%:&amp;nbsp;%c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" c4Technology="PostgreSQL" c4Description="Заявки, id заявки в каждой СК, дедлайн и lease опроса, полученные предложения"><mxCell style="shape=cylinder3;size=5.9999511718749545;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=12;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;metaEdit=1;points=[[0.5,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.5,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];resizable=0;" vertex="1" parent="1"><mxGeometry x="1560" y="160" width="220" height="100" as="geometry" /></mxCell></object><object placeholders="1" id="task4-3" c4Name="Redis" c4Type="Container" label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" c4Technology="Managed Service for Redis" c4Description="Pub/Sub для рассылки предложений экземплярам core-app; token bucket на каждую СК"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="1020" y="240" width="190" height="110" as="geometry" /></mxCell></object><object placeholders="1" id="task4-4" c4Type="Relationship" c4Technology="WebSocket (WSS)" c4Description="Поток предложений по заявке ОСАГО&#10;(сразу по мере ответа СК)" label="&lt;div style=&quot;text-align: left&quot;&gt;&lt;div style=&quot;text-align: center&quot;&gt;&lt;b&gt;%c4Description%&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center&quot;&gt;[%c4Technology%]&lt;/div&gt;&lt;/div&gt;"><mxCell style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;elbow=vertical;metaEdit=1;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.83;exitY=0;exitDx=0;exitDy=0;entryX=0.83;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="uZ0quFO-MIEIE11IO5jD-3" target="uZ0quFO-MIEIE11IO5jD-4"><mxGeometry width="160" relative="1" as="geometry"><mxPoint x="100" y="-50" as="offset" /></mxGeometry></mxCell></object><object placeholders="1" id="task4-5" c4Type="Relationship" c4Technology="Redis Pub/Sub" c4Description="Pub/Sub: предложение → все экземпляры&#10;(у кого WebSocket-сессия клиента)" label="&lt;div style=&quot;text-align: left&quot;&gt;&lt;div style=&quot;text-align: center&quot;&gt;&lt;b&gt;%c4Description%&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center&quot;&gt;[%c4Technology%]&lt;/div&gt;&lt;/div&gt;"><mxCell style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;elbow=vertical;metaEdit=1;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.1;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="uZ0quFO-MIEIE11IO5jD-3" target="task4-3"><mxGeometry width="160" relative="1" as="geometry" x="0.1"><Array as="points"><mxPoint x="940" y="443" /><mxPoint x="940" y="322" /></Array></mxGeometry></mxCell></object><object placeholders="1" id="task4-6" c4Type="Relationship" c4Technology="Kafka consumer" c4Description="Подписка: osago.requests" label="&lt;div style=&quot;text-align: left&quot;&gt;&lt;div style=&quot;text-align: center&quot;&gt;&lt;b&gt;%c4Description%&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center&quot;&gt;[%c4Technology%]&lt;/div&gt;&lt;/div&gt;"><mxCell style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;elbow=vertical;metaEdit=1;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;edgeStyle=orthogonalEdgeStyle;dashed=1;dashPattern=6 4;strokeColor=#0E7DAD;fontColor=#0E7DAD;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="task3-1" target="task4-1"><mxGeometry width="160" relative="1" as="geometry" x="0.6"><Array as="points"><mxPoi